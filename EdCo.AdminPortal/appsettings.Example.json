{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Antiforgery": "Debug",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/edco-admin-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "OpenTelemetry": {
    "ServiceName": "EdCo.AdminPortal",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_SERVER;Database=EdCoDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "EdCoApi": {
    "BaseUrl": "http://localhost:5075"
  },
  "BunnyNet": {
    "ApiKey": "YOUR_BUNNYNET_API_KEY",
    "LibraryId": "YOUR_BUNNYNET_LIBRARY_ID"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models/",
    "ModelName": "gemini-flash-latest"
  },
  "Groq": {
    "ApiKey": "YOUR_GROQ_API_KEY",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "VisionModelName": "qwen/qwen3.6-27b"
  },
  "Storage": {
    "LocalUploadPath": "App_Data/Uploads"
  }
}
