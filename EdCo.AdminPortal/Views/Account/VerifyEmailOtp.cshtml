@model EdCo.AdminPortal.Models.Account.TwoFactorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Security Code Verification - EdCo";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('edco_admin_theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root, [data-bs-theme="dark"] {
            --bg-main: #090d16;
            --card-bg: rgba(18, 24, 38, 0.85);
            --card-border: rgba(255, 255, 255, 0.08);
            --accent-purple: #6366f1;
            --accent-pink: #ec4899;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --input-bg: rgba(255, 255, 255, 0.04);
            --input-border: rgba(255, 255, 255, 0.1);
            --bg-radial-1: rgba(99, 102, 241, 0.15);
            --bg-radial-2: rgba(236, 72, 153, 0.15);
            --box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        [data-bs-theme="light"] {
            --bg-main: #f8fafc;
            --card-bg: #ffffff;
            --card-border: #e2e8f0;
            --accent-purple: #4f46e5;
            --accent-pink: #db2777;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --input-bg: #f1f5f9;
            --input-border: #cbd5e1;
            --bg-radial-1: rgba(99, 102, 241, 0.08);
            --bg-radial-2: rgba(236, 72, 153, 0.08);
            --box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: 
                radial-gradient(at 0% 0%, var(--bg-radial-1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, var(--bg-radial-2) 0px, transparent 50%);
            margin: 0;
            padding: 20px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .login-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            backdrop-filter: blur(16px);
            box-shadow: var(--box-shadow);
            width: 100%;
            max-width: 440px;
            padding: 40px;
        }

        .brand-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--accent-purple), var(--accent-pink));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
            margin: 0 auto 20px;
        }

        .form-control {
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            color: var(--text-primary);
            border-radius: 12px;
            padding: 14px;
            font-weight: 700;
            letter-spacing: 4px;
            text-align: center;
            font-size: 1.25rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-purple), #4f46e5);
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 700;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h3 class="fw-bold mb-1">Two-Factor Auth</h3>
            <p class="text-secondary small" style="color: var(--text-secondary) !important;">We sent a security code to your email.</p>
        </div>

        <form asp-action="VerifyEmailOtp" method="post">
            <input type="hidden" asp-for="RememberMe" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small py-2 mb-3"></div>

            <div class="mb-4">
                <label asp-for="Code" class="form-label small fw-bold" style="color: var(--text-secondary);">Enter Security Code</label>
                <input asp-for="Code" class="form-control" placeholder="123456" autocomplete="off" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Verify Code</button>

            <div class="text-center">
                <button type="button" id="resendBtn" class="btn btn-link text-decoration-none small" style="color: var(--text-secondary);">Resend Code</button>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('resendBtn').addEventListener('click', async function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const res = await fetch('/Account/ResendEmailOtp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                }
            });
            const data = await res.json();
            alert(data.message);
        });
    </script>
</body>
</html>
