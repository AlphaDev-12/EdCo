@model EdCo.AdminPortal.Models.Account.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Log in - EdCo Admin Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('edco_admin_theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root, [data-bs-theme="dark"] {
            --bg-main: #090d16;
            --card-bg: rgba(18, 24, 38, 0.85);
            --card-border: rgba(255, 255, 255, 0.08);
            --accent-purple: #6366f1;
            --accent-pink: #ec4899;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --input-bg: rgba(255, 255, 255, 0.04);
            --input-border: rgba(255, 255, 255, 0.1);
            --bg-radial-1: rgba(99, 102, 241, 0.15);
            --bg-radial-2: rgba(236, 72, 153, 0.15);
            --box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            --link-color: #818cf8;
            --link-hover: #a5b4fc;
        }

        [data-bs-theme="light"] {
            --bg-main: #f8fafc;
            --card-bg: #ffffff;
            --card-border: #e2e8f0;
            --accent-purple: #4f46e5;
            --accent-pink: #db2777;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --input-bg: #f1f5f9;
            --input-border: #cbd5e1;
            --bg-radial-1: rgba(99, 102, 241, 0.08);
            --bg-radial-2: rgba(236, 72, 153, 0.08);
            --box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
            --link-color: #4f46e5;
            --link-hover: #4338ca;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: 
                radial-gradient(at 0% 0%, var(--bg-radial-1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, var(--bg-radial-2) 0px, transparent 50%);
            margin: 0;
            padding: 20px;
            position: relative;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .theme-toggle-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-primary);
            border-radius: 30px;
            padding: 8px 16px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: var(--box-shadow);
            transition: all 0.2s ease;
        }

        .theme-toggle-btn:hover {
            transform: translateY(-1px);
        }

        .login-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            backdrop-filter: blur(16px);
            box-shadow: var(--box-shadow);
            width: 100%;
            max-width: 440px;
            padding: 40px;
            transition: all 0.3s ease;
        }

        .brand-logo-container {
            margin: 0 auto 4px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .brand-logo {
            width: 180px;
            height: 180px;
            object-fit: contain;
            filter: drop-shadow(0 8px 16px rgba(99, 102, 241, 0.4));
            transition: transform 0.3s ease;
        }

        .brand-logo:hover {
            transform: scale(1.05);
        }

        .form-control {
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            color: var(--text-primary);
            border-radius: 12px;
            padding: 12px 16px;
            font-weight: 500;
        }

        .form-control:focus {
            background: var(--input-bg);
            border-color: var(--accent-purple);
            color: var(--text-primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
        }

        .input-group .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .toggle-password-btn {
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-left: none;
            color: var(--text-secondary);
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            padding: 0 16px;
            transition: all 0.2s ease;
        }

        .toggle-password-btn:hover, .toggle-password-btn:focus {
            background: var(--input-bg);
            color: var(--text-primary);
            border-color: var(--input-border);
            box-shadow: none;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-purple), #4f46e5);
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 700;
            letter-spacing: 0.3px;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
            transition: all 0.2s ease;
            color: #ffffff;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 24px rgba(99, 102, 241, 0.4);
            color: #ffffff;
        }

        .text-secondary-custom {
            color: var(--text-secondary);
        }

        a.link-purple {
            color: var(--link-color);
            text-decoration: none;
            font-weight: 600;
        }

        a.link-purple:hover {
            color: var(--link-hover);
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <button class="theme-toggle-btn" onclick="toggleTheme()" id="themeToggleBtn">
        <i class="fa-solid fa-moon" id="themeIcon"></i>
        <span id="themeText">Theme</span>
    </button>

    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-logo-container">
                <img src="/images/logo.png" alt="EdCo Logo" class="brand-logo" />
            </div>
            <h3 class="fw-bold mb-1">Welcome back</h3>
            <p class="text-secondary-custom fs-7">Sign in to your StudyPro Admin account</p>
        </div>

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group">
                    <input asp-for="Email" class="form-control" placeholder="admin@edco.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label mb-0">Password</label>
                    <a asp-action="ForgotPassword" class="link-purple small">Forgot password?</a>
                </div>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" type="password" id="passwordInput" placeholder="••••••••" />
                    <button class="btn toggle-password-btn" type="button" id="togglePasswordBtn" title="View password">
                        <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" style="background-color: var(--input-bg); border-color: var(--input-border);" />
                <label class="form-check-label text-secondary-custom small" for="rememberMeCheck">Remember me</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
            </button>
        </form>
    </div>

    <script>
        function updateThemeUI(theme) {
            const icon = document.getElementById('themeIcon');
            const text = document.getElementById('themeText');
            if (theme === 'light') {
                if (icon) icon.className = 'fa-solid fa-sun text-warning';
                if (text) text.innerText = 'Light';
            } else {
                if (icon) icon.className = 'fa-solid fa-moon text-info';
                if (text) text.innerText = 'Dark';
            }
        }

        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-bs-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', next);
            localStorage.setItem('edco_admin_theme', next);
            updateThemeUI(next);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'dark';
            updateThemeUI(currentTheme);

            document.getElementById('togglePasswordBtn')?.addEventListener('click', function () {
                const input = document.getElementById('passwordInput');
                const icon = document.getElementById('togglePasswordIcon');
                if (input && icon) {
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('fa-eye');
                        icon.classList.add('fa-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('fa-eye-slash');
                        icon.classList.add('fa-eye');
                    }
                }
            });
        });
    </script>
</body>
</html>
