@model EdCo.AdminPortal.Models.Account.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password - EdCo";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('edco_admin_theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root, [data-bs-theme="dark"] {
            --bg-main: #090d16;
            --card-bg: rgba(18, 24, 38, 0.85);
            --card-border: rgba(255, 255, 255, 0.08);
            --accent-purple: #6366f1;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --input-bg: rgba(255, 255, 255, 0.04);
            --input-border: rgba(255, 255, 255, 0.1);
            --box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        [data-bs-theme="light"] {
            --bg-main: #f8fafc;
            --card-bg: #ffffff;
            --card-border: #e2e8f0;
            --accent-purple: #4f46e5;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --input-bg: #f1f5f9;
            --input-border: #cbd5e1;
            --box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .login-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            box-shadow: var(--box-shadow);
            width: 100%;
            max-width: 440px;
            padding: 40px;
        }

        .brand-logo-container {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

        .brand-logo {
            width: 110px;
            height: 110px;
            object-fit: contain;
        }

        .form-control {
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            color: var(--text-primary);
            border-radius: 12px;
            padding: 12px 16px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-purple), #4f46e5);
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 700;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <div class="brand-logo-container">
            <img src="/images/logo.png" alt="EdCo Logo" class="brand-logo" />
        </div>
        <h3 class="fw-bold mb-2">Forgot Password</h3>
        <p class="text-secondary small mb-4" style="color: var(--text-secondary) !important;">Enter your email address and we'll send you a password reset link.</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small py-2 mb-3"></div>

            <div class="mb-4 text-start">
                <label asp-for="Email" class="form-label small fw-bold" style="color: var(--text-secondary);">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="admin@edco.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Send Reset Link</button>
            <div>
                <a asp-action="Login" class="text-decoration-none small" style="color: var(--text-secondary);"><i class="fa-solid fa-arrow-left me-1"></i> Back to Login</a>
            </div>
        </form>
    </div>
</body>
</html>
