@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card p-5 mx-auto" style="max-width: 500px; border-radius: 20px;">
        <div class="mb-3 text-warning">
            <i class="fa-solid fa-triangle-exclamation fa-4x"></i>
        </div>
        <h2 class="fw-bold mb-2">Access Denied</h2>
        <p class="text-muted mb-4">You do not have sufficient administrative permissions to access this resource.</p>
        <div>
            <a href="/" class="btn btn-primary px-4 py-2 rounded-3"><i class="fa-solid fa-house me-2"></i>Return to Dashboard</a>
        </div>
    </div>
</div>
