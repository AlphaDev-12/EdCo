@model List<EdCo.Core.Entities.AppErrorLog>
@{
    ViewData["Title"] = "System Error Dashboard";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string search = ViewBag.Search ?? "";
    string sourceFilter = ViewBag.SourceFilter ?? "";
    string logLevelFilter = ViewBag.LogLevelFilter ?? "";
    bool? isResolvedFilter = ViewBag.IsResolvedFilter;
    var stats = ViewBag.Stats as Dictionary<string, int> ?? new Dictionary<string, int>();

    int totalUnresolved = stats.GetValueOrDefault("TotalUnresolved", 0);
    int errors24h = stats.GetValueOrDefault("Errors24h", 0);
    int apiErrors = stats.GetValueOrDefault("ApiErrors", 0);
    int adminErrors = stats.GetValueOrDefault("AdminErrors", 0);
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-slate-800 mb-1">
                <i class="bi bi-bug-fill text-danger me-2"></i>System Exception Telemetry
            </h1>
            <p class="text-muted small mb-0">Monitor unhandled exceptions, application failures, HTTP error codes, and stack traces across EdCo platforms.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-shield-check me-1"></i> Admin Audit Logs
            </a>
            <a asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small uppercase fw-semibold">Unresolved Errors</span>
                            <h2 class="fw-bold mb-0 text-white">@totalUnresolved</h2>
                        </div>
                        <div class="fs-1 text-white-50"><i class="bi bi-exclamation-octagon"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-dark-50 small uppercase fw-semibold">Errors (Past 24h)</span>
                            <h2 class="fw-bold mb-0 text-dark">@errors24h</h2>
                        </div>
                        <div class="fs-1 text-dark-50"><i class="bi bi-clock-history"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-dark text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small uppercase fw-semibold">API Unresolved</span>
                            <h2 class="fw-bold mb-0 text-white">@apiErrors</h2>
                        </div>
                        <div class="fs-1 text-white-50"><i class="bi bi-hdd-network"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small uppercase fw-semibold">Admin Portal Unresolved</span>
                            <h2 class="fw-bold mb-0 text-white">@adminErrors</h2>
                        </div>
                        <div class="fs-1 text-white-50"><i class="bi bi-layout-wpt"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Search message, path, trace ID..." value="@search">
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="source" class="form-select bg-light">
                        <option value="All">All Sources</option>
                        <option value="API" selected="@(sourceFilter == "API")">API</option>
                        <option value="AdminPortal" selected="@(sourceFilter == "AdminPortal")">Admin Portal</option>
                        <option value="AiTutor" selected="@(sourceFilter == "AiTutor")">AI Tutor</option>
                        <option value="Paynow" selected="@(sourceFilter == "Paynow")">Paynow</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="logLevel" class="form-select bg-light">
                        <option value="All">All Severity Levels</option>
                        <option value="Error" selected="@(logLevelFilter == "Error")">Error</option>
                        <option value="Critical" selected="@(logLevelFilter == "Critical")">Critical</option>
                        <option value="Warning" selected="@(logLevelFilter == "Warning")">Warning</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="isResolved" class="form-select bg-light">
                        <option value="">All Resolution Statuses</option>
                        <option value="false" selected="@(isResolvedFilter == false)">Unresolved Only</option>
                        <option value="true" selected="@(isResolvedFilter == true)">Resolved Only</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-x-circle"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Error Logs Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-slate-700">Application Exception Logs (@totalCount total)</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small uppercase">
                    <tr>
                        <th>ID</th>
                        <th>Timestamp (UTC)</th>
                        <th>Source</th>
                        <th>Severity</th>
                        <th>Endpoint / Path</th>
                        <th>Message</th>
                        <th>User</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                                No application errors found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var err in Model)
                        {
                            var severityBadge = err.LogLevel switch
                            {
                                "Critical" => "bg-danger text-white",
                                "Warning" => "bg-warning text-dark",
                                _ => "bg-danger-subtle text-danger border border-danger"
                            };

                            var sourceBadge = err.Source switch
                            {
                                "API" => "bg-dark text-white",
                                "AdminPortal" => "bg-info text-dark",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <td class="small fw-bold">#@err.Id</td>
                                <td class="small font-monospace">@err.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><span class="badge @sourceBadge">@err.Source</span></td>
                                <td><span class="badge @severityBadge">@err.LogLevel</span></td>
                                <td class="small font-monospace text-slate-700">
                                    @if (!string.IsNullOrEmpty(err.HttpMethod))
                                    {
                                        <span class="badge bg-light text-dark border me-1">@err.HttpMethod</span>
                                    }
                                    @(err.RequestPath ?? "N/A")
                                </td>
                                <td class="small fw-semibold text-danger" style="max-width: 280px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="@err.Message">
                                    @err.Message
                                </td>
                                <td class="small">
                                    @(err.UserName ?? err.UserId ?? "Anonymous")
                                </td>
                                <td>
                                    @if (err.IsResolved)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">
                                            <i class="bi bi-check2-circle me-1"></i>Resolved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">
                                            <i class="bi bi-exclamation-circle me-1"></i>Unresolved
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="viewStackTrace(@err.Id)">
                                        <i class="bi bi-code-slash me-1"></i>Trace
                                    </button>
                                    @if (!err.IsResolved)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" onclick="openResolveModal(@err.Id)">
                                            <i class="bi bi-check-lg me-1"></i>Resolve
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <span class="small text-muted">Page @currentPage of @totalPages</span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-source="@sourceFilter" asp-route-logLevel="@logLevelFilter" asp-route-isResolved="@isResolvedFilter">Previous</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@currentPage</span></li>
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-source="@sourceFilter" asp-route-logLevel="@logLevelFilter" asp-route-isResolved="@isResolvedFilter">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

<!-- Stack Trace Modal -->
<div class="modal fade" id="stackTraceModal" tabindex="-1" aria-labelledby="stackTraceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white py-3">
                <h5 class="modal-title font-monospace" id="stackTraceModalLabel">
                    <i class="bi bi-terminal me-2 text-warning"></i>Exception Stack Trace
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <div class="row g-2 small text-muted mb-2">
                        <div class="col-md-6"><strong>Error ID:</strong> <span id="modalErrorId">-</span></div>
                        <div class="col-md-6"><strong>Timestamp:</strong> <span id="modalTimestamp">-</span></div>
                        <div class="col-md-6"><strong>Source:</strong> <span id="modalSource">-</span></div>
                        <div class="col-md-6"><strong>Trace ID:</strong> <span id="modalTraceId" class="font-monospace">-</span></div>
                        <div class="col-md-6"><strong>Endpoint:</strong> <span id="modalEndpoint" class="font-monospace">-</span></div>
                        <div class="col-md-6"><strong>User:</strong> <span id="modalUser">-</span></div>
                    </div>
                    <div class="alert alert-danger font-monospace small mb-3" id="modalExceptionMessage">
                        Exception message will load here...
                    </div>
                </div>
                <h6 class="fw-bold text-slate-700 mb-2"><i class="bi bi-list-nested me-1"></i>Stack Trace</h6>
                <pre class="bg-dark text-light p-3 rounded font-monospace small" id="modalStackTrace" style="max-height: 400px; overflow-y: auto; white-space: pre-wrap; word-break: break-all;">
Loading stack trace...
                </pre>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Resolve Error Modal -->
<div class="modal fade" id="resolveModal" tabindex="-1" aria-labelledby="resolveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Resolve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="resolveErrorId" value="" />
                <div class="modal-header bg-success text-white py-3">
                    <h5 class="modal-title" id="resolveModalLabel">
                        <i class="bi bi-check-circle me-2"></i>Resolve System Error
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small">Are you sure you want to mark this system error as resolved? Add optional resolution notes for audit tracking.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Resolution Notes</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="e.g. Fixed null reference in AiGradingController or updated Groq API key limits."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Mark Resolved</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewStackTrace(id) {
            fetch('/ErrorLogs/Details/' + id)
                .then(response => {
                    if (!response.ok) throw new Error('Error fetching details');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('modalErrorId').innerText = '#' + data.id;
                    document.getElementById('modalTimestamp').innerText = new Date(data.createdAt).toISOString().replace('T', ' ').substring(0, 19);
                    document.getElementById('modalSource').innerText = data.source + ' (' + data.logLevel + ')';
                    document.getElementById('modalTraceId').innerText = data.traceId || 'N/A';
                    document.getElementById('modalEndpoint').innerText = (data.httpMethod ? data.httpMethod + ' ' : '') + (data.requestPath || 'N/A');
                    document.getElementById('modalUser').innerText = data.userName || data.userId || 'Anonymous';
                    document.getElementById('modalExceptionMessage').innerText = (data.exceptionType ? data.exceptionType + ': ' : '') + data.message;
                    document.getElementById('modalStackTrace').innerText = data.stackTrace || 'No stack trace recorded.';

                    var modal = new bootstrap.Modal(document.getElementById('stackTraceModal'));
                    modal.show();
                })
                .catch(err => {
                    alert('Failed to load error trace details: ' + err.message);
                });
        }

        function openResolveModal(id) {
            document.getElementById('resolveErrorId').value = id;
            var modal = new bootstrap.Modal(document.getElementById('resolveModal'));
            modal.show();
        }
    </script>
}
