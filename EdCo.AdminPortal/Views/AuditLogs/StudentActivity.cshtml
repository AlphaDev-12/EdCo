@model List<EdCo.Core.Entities.StudentActivityLog>
@{
    ViewData["Title"] = "Student App Usage & Telemetry";
    var summary = ViewBag.Summary as EdCo.Core.Interfaces.StudentUsageSummary ?? new EdCo.Core.Interfaces.StudentUsageSummary();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string search = ViewBag.Search ?? "";
    string activityType = ViewBag.ActivityType ?? "";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-slate-800 mb-1">
                <i class="bi bi-activity text-indigo me-2"></i>Student Usage & Analytics Telemetry
            </h1>
            <p class="text-muted small mb-0">Monitor real-time student engagement, active usage, AI interactions, and quiz attempts.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Admin Audit Logs
            </a>
        </div>
    </div>

    <!-- Primary Analytics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-gradient text-white" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small uppercase opacity-75 fw-semibold">Active Students (24h)</span>
                            <h2 class="fw-bold mb-0 mt-1">@summary.TotalActiveStudents</h2>
                        </div>
                        <div class="fs-1 opacity-50"><i class="bi bi-people-fill"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-gradient text-white" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small uppercase opacity-75 fw-semibold">Total Events (24h)</span>
                            <h2 class="fw-bold mb-0 mt-1">@summary.TotalActivities24h</h2>
                        </div>
                        <div class="fs-1 opacity-50"><i class="bi bi-lightning-charge-fill"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-gradient text-white" style="background: linear-gradient(135deg, #10b981, #059669);">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small uppercase opacity-75 fw-semibold">Units Viewed</span>
                            <h2 class="fw-bold mb-0 mt-1">@summary.TotalUnitsViewed</h2>
                        </div>
                        <div class="fs-1 opacity-50"><i class="bi bi-journal-text"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-gradient text-white" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small uppercase opacity-75 fw-semibold">AI Tutor Engagements</span>
                            <h2 class="fw-bold mb-0 mt-1">@summary.TotalAiInteractions</h2>
                        </div>
                        <div class="fs-1 opacity-50"><i class="bi bi-robot"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Student Quiz & AI Unit Cost Telemetry Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-left: 4px solid #10b981 !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase text-muted fw-bold small">Quiz Engagement</span>
                            <h3 class="fw-bold mb-0 mt-1 text-slate-800">@summary.TotalQuizzesAttempted <span class="fs-6 text-muted fw-normal">attempts</span></h3>
                            <div class="small text-muted mt-1">
                                <strong>@summary.UniqueStudentsWithQuizEngagement</strong> unique quiz takers &bull; 
                                <strong>@summary.AverageQuizzesPerStudent.ToString("F1")</strong> quizzes / student
                            </div>
                        </div>
                        <div class="fs-1 text-success opacity-75"><i class="bi bi-check2-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-left: 4px solid #3b82f6 !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase text-muted fw-bold small">Avg Token Usage / Student</span>
                            <h3 class="fw-bold mb-0 mt-1 text-primary">@summary.AverageTokensPerStudent.ToString("N0") <span class="fs-6 text-muted fw-normal">tokens</span></h3>
                            <div class="small text-muted mt-1">
                                Total tokens: <strong>@summary.TotalTokensConsumed.ToString("N0")</strong>
                            </div>
                        </div>
                        <div class="fs-1 text-primary opacity-75"><i class="bi bi-cpu"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-left: 4px solid #8b5cf6 !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase text-muted fw-bold small">Avg AI Cost / Student</span>
                            <h3 class="fw-bold mb-0 mt-1 text-indigo">$@summary.AverageAiCostPerStudent.ToString("F4") <span class="fs-6 text-muted fw-normal">/ student</span></h3>
                            <div class="small text-muted mt-1">
                                Total AI spend: <strong>$@summary.TotalAiCost.ToString("F4")</strong>
                            </div>
                        </div>
                        <div class="fs-1 text-indigo opacity-75"><i class="bi bi-currency-dollar"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Search student email, activity, details..." value="@search">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="activityType" class="form-select bg-light">
                        <option value="">-- All Activity Types --</option>
                        <option value="StudentLogin" selected="@(activityType == "StudentLogin")">Student Login</option>
                        <option value="StudentRegister" selected="@(activityType == "StudentRegister")">Student Register</option>
                        <option value="AiTutorEngaged" selected="@(activityType == "AiTutorEngaged")">AI Tutor Engaged</option>
                        <option value="QuizAttempted" selected="@(activityType == "QuizAttempted")">Quiz Attempted</option>
                        <option value="UnitViewed" selected="@(activityType == "UnitViewed")">Unit Viewed</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                    <a asp-action="StudentActivity" class="btn btn-light border"><i class="bi bi-x-circle"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Activity Log Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-slate-700">Student Telemetry Logs (@totalCount total)</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small uppercase">
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>Student Email</th>
                        <th>Activity Event</th>
                        <th>Details</th>
                        <th>Device</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-slate-300"></i>
                                No student telemetry records recorded yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td class="small font-monospace">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <span class="fw-semibold text-slate-800">@(log.StudentEmail ?? log.StudentId ?? "Anonymous")</span>
                                </td>
                                <td>
                                    <span class="badge bg-indigo-subtle text-indigo border border-indigo">@log.ActivityType</span>
                                </td>
                                <td class="small text-muted" style="max-width: 350px;">
                                    @log.Details
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border"><i class="bi bi-phone me-1"></i>@(log.DeviceFamily ?? "MobileApp")</span>
                                </td>
                                <td class="small font-monospace text-muted">@(log.IpAddress ?? "N/A")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <span class="small text-muted">Page @currentPage of @totalPages</span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="StudentActivity" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-activityType="@activityType">Previous</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@currentPage</span></li>
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="StudentActivity" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-activityType="@activityType">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
