@model EdCo.AdminPortal.Models.SubscriptionsViewModel

@{
    ViewData["Title"] = "Subscriptions Overview";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-credit-card text-primary me-2"></i> Subscriptions Overview</h2>
</div>

<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card bg-success text-white border-success">
            <div class="card-body d-flex align-items-center">
                <i class="fa-solid fa-users fa-3x me-3 opacity-50"></i>
                <div>
                    <h5 class="card-title mb-0">Total Active Subscribers</h5>
                    <h2 class="mb-0 fw-bold">@Model.TotalActiveSubscribers</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card bg-primary text-white border-primary">
            <div class="card-body d-flex align-items-center">
                <i class="fa-solid fa-money-bill-wave fa-3x me-3 opacity-50"></i>
                <div>
                    <h5 class="card-title mb-0">Total Revenue</h5>
                    <h2 class="mb-0 fw-bold">@Model.TotalRevenue.ToString("C")</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white border-danger">
            <div class="card-body d-flex align-items-center">
                <i class="fa-solid fa-arrow-trend-down fa-3x me-3 opacity-50"></i>
                <div>
                    <h5 class="card-title mb-0">Churn Rate</h5>
                    <h2 class="mb-0 fw-bold">@Model.ChurnRate.ToString("P1")</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Admin Subscription Fee & Duration Configuration Card -->
<div class="card mb-4 border-info">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-sliders text-info me-2"></i> Configure Tier Subscription Fees & Durations</span>
        <span class="badge bg-info text-dark">Admin Controls</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var tier in Model.GradeLevels)
            {
                <div class="col-md-4">
                    <div class="p-3 border rounded" style="background-color: var(--bg-subtle); border-color: var(--border-color) !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong style="color: var(--text-primary);">@tier.Name</strong>
                            <span class="badge @(tier.IsActive ? "bg-success" : "bg-secondary")">@(tier.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <p class="mb-1 text-muted small">Current Fee: <span class="text-success fw-bold">$@tier.TierPrice.ToString("F2")</span></p>
                        <p class="mb-2 text-muted small">Current Duration: <span class="text-warning fw-bold">@tier.SubscriptionDurationDays Days</span> (@(Math.Round((double)tier.SubscriptionDurationDays / 30.0, 1)) mo)</p>
                        <button class="btn btn-sm btn-outline-info w-100 mt-1" data-bs-toggle="modal" data-bs-target="#editTierRatesModal-@tier.Id">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Fee & Duration
                        </button>
                    </div>
                </div>

                <!-- Modal for Tier Edit -->
                <div class="modal fade" id="editTierRatesModal-@tier.Id" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content" style="background-color: var(--bg-surface); border: 1px solid var(--border-color); color: var(--text-primary);">
                            <form asp-action="UpdateTierRates" method="post">
                                <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                                    <h5 class="modal-title"><i class="fa-solid fa-sliders text-info me-2"></i> Edit Subscription Rate for @tier.Name</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="gradeId" value="@tier.Id" />
                                    <div class="mb-3">
                                        <label class="form-label"><i class="fa-solid fa-dollar-sign text-success me-1"></i> Subscription Fee ($)</label>
                                        <input type="number" step="0.01" min="0" class="form-control" name="tierPrice" value="@tier.TierPrice" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label"><i class="fa-solid fa-clock text-warning me-1"></i> Subscription Duration (Days)</label>
                                        <input type="number" min="1" max="3650" class="form-control" name="subscriptionDurationDays" value="@tier.SubscriptionDurationDays" required />
                                        <small class="text-muted">Enter duration in days (e.g. 30 for 1 month, 90 for 3 months, 365 for 1 year).</small>
                                    </div>
                                </div>
                                <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i> Save Subscription Settings</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by student name or email..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="expired" selected="@(Model.StatusFilter == "expired")">Expired</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="pageSize" class="form-select">
                    <option value="10" selected="@(Model.PageSize == 10)">10 per page</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25 per page</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-list me-2"></i> Subscriber List (@Model.TotalItems items)</span>
        <span class="badge bg-secondary">Page @Model.PageIndex of @Model.TotalPages</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Email</th>
                    <th>Grade Level</th>
                    <th>Tier Price</th>
                    <th>Status</th>
                    <th>End Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in Model.Subscribers)
                {
                    <tr>
                        <td>@sub.FullName</td>
                        <td>@sub.Email</td>
                        <td><span class="badge bg-secondary">@sub.GradeLevelName</span></td>
                        <td>@sub.TierPrice.ToString("C")</td>
                        <td>
                            @if (sub.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Expired</span>
                            }
                        </td>
                        <td>
                            @(sub.SubscriptionEndDate.HasValue ? sub.SubscriptionEndDate.Value.ToString("MMM dd, yyyy") : "N/A")
                        </td>
                    </tr>
                }
                @if (!Model.Subscribers.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No subscriptions found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="text-muted small">Showing @(((Model.PageIndex - 1) * Model.PageSize) + 1) to @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems)) of @Model.TotalItems entries</span>
            <nav aria-label="Subscription pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter">Previous</a>
                    </li>
                    
                    @for (int p = Math.Max(1, Model.PageIndex - 2); p <= Math.Min(Model.TotalPages, Model.PageIndex + 2); p++)
                    {
                        <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter">@p</a>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
