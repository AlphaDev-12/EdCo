@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden my-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #f8fafc;">
                <div class="card-body p-5">
                    <div class="mb-4">
                        @if (Model.StatusCode == 404)
                        {
                            <div class="display-1 fw-bold text-warning mb-2" style="font-size: 5rem; text-shadow: 0 0 20px rgba(234, 179, 8, 0.4);">404</div>
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill fw-semibold mb-3">Resource Missing</span>
                        }
                        else if (Model.StatusCode == 403)
                        {
                            <div class="display-1 fw-bold text-danger mb-2" style="font-size: 5rem; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">403</div>
                            <span class="badge bg-danger px-3 py-2 fs-6 rounded-pill fw-semibold mb-3">Access Restricted</span>
                        }
                        else if (Model.StatusCode == 401)
                        {
                            <div class="display-1 fw-bold text-info mb-2" style="font-size: 5rem; text-shadow: 0 0 20px rgba(14, 165, 233, 0.4);">401</div>
                            <span class="badge bg-info text-dark px-3 py-2 fs-6 rounded-pill fw-semibold mb-3">Authentication Required</span>
                        }
                        else
                        {
                            <div class="display-1 fw-bold text-danger mb-2" style="font-size: 5rem; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">@Model.StatusCode</div>
                            <span class="badge bg-danger px-3 py-2 fs-6 rounded-pill fw-semibold mb-3">System Exception</span>
                        }
                    </div>

                    <h2 class="fw-bold mb-3">@Model.Title</h2>
                    <p class="text-secondary fs-5 mb-4" style="color: #94a3b8 !important;">
                        @Model.Description
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="p-3 mb-4 rounded-3 text-start font-monospace small" style="background-color: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); color: #cbd5e1;">
                            <i class="bi bi-fingerprint text-primary me-2"></i>
                            <strong>Trace Identifier:</strong> <code>@Model.RequestId</code>
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="javascript:history.back()" class="btn btn-outline-light px-4 py-2 rounded-3 fw-semibold">
                            <i class="bi bi-arrow-left me-2"></i>Go Back
                        </a>
                        <a href="/Dashboard" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border: none;">
                            <i class="bi bi-house-door me-2"></i>Return to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
