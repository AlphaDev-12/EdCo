@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <script>
        (function () {
            var savedTheme = localStorage.getItem('edco_theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root, [data-bs-theme="dark"] {
            --bg-main: #0d1117;
            --bg-surface: #161b22;
            --bg-subtle: #21262d;
            --border-color: #30363d;
            --text-primary: #c9d1d9;
            --text-muted: #8b949e;
            --accent-blue: #58a6ff;
            --nav-hover: #21262d;
            --input-bg: #0d1117;
            --card-shadow: 0 4px 12px rgba(0,0,0,0.3);
        }

        [data-bs-theme="light"] {
            --bg-main: #f6f8fa;
            --bg-surface: #ffffff;
            --bg-subtle: #f3f4f6;
            --border-color: #e1e4e8;
            --text-primary: #1f2328;
            --text-muted: #656d76;
            --accent-blue: #0969da;
            --nav-hover: #f0f2f5;
            --input-bg: #ffffff;
            --card-shadow: 0 4px 12px rgba(0,0,0,0.05);
        }

        body { font-family: 'Inter', sans-serif; background-color: var(--bg-main); color: var(--text-primary); transition: background-color 0.3s, color 0.3s; }
        .text-muted { color: var(--text-muted) !important; }
        .text-secondary { color: var(--text-muted) !important; }
        .table { color: var(--text-primary); border-color: var(--border-color); }
        .table th, .table td { color: var(--text-primary); border-color: var(--border-color); }
        .modal-content { background-color: var(--bg-surface); color: var(--text-primary); border-color: var(--border-color); }
        .modal-header, .modal-footer { border-color: var(--border-color); }
        .sidebar { height: 100vh; position: fixed; top: 0; left: 0; width: 250px; background-color: var(--bg-surface); border-right: 1px solid var(--border-color); padding-top: 15px; transition: width 0.3s, background-color 0.3s, border-color 0.3s; z-index: 1000; overflow-x: hidden; display: flex; flex-direction: column; justify-content: space-between; }
        .sidebar.collapsed { width: 70px; }
        .sidebar .nav-link { color: var(--text-muted); padding: 10px 20px; transition: 0.3s; white-space: nowrap; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: var(--accent-blue); background-color: var(--nav-hover); }
        .sidebar .nav-link i { width: 25px; text-align: center; }
        .sidebar.collapsed .nav-link span, .sidebar.collapsed .sidebar-title span, .sidebar.collapsed .user-profile-text, .sidebar.collapsed .theme-toggle-label { display: none; }
        .sidebar-logo { max-width: 180px; width: 100%; height: auto; max-height: 80px; object-fit: contain; display: block; margin: 0 auto; transition: all 0.3s ease; }
        .sidebar.collapsed .sidebar-logo { max-width: 40px; max-height: 40px; }
        .main-content { margin-left: 250px; padding: 20px; min-height: 100vh; transition: margin-left 0.3s, background-color 0.3s; }
        .main-content.expanded { margin-left: 70px; }
        #sidebarToggle { background: none; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer; transition: 0.3s; }
        #sidebarToggle:hover { color: var(--accent-blue); }
        .sidebar.collapsed #sidebarToggle { text-align: center; width: 100%; }
        .card { background-color: var(--bg-surface); border: 1px solid var(--border-color); box-shadow: var(--card-shadow); margin-bottom: 20px; }
        .card-header { background-color: var(--bg-subtle); border-bottom: 1px solid var(--border-color); color: var(--text-primary); font-weight: bold; }
        .btn-primary { background-color: #238636; border-color: #2ea043; }
        .btn-primary:hover { background-color: #2ea043; border-color: #3fb950; }
        .form-control, .form-select { background-color: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-primary); }
        .form-control:focus, .form-select:focus { background-color: var(--input-bg); color: var(--text-primary); border-color: var(--accent-blue); box-shadow: 0 0 0 0.25rem rgba(88,166,255,.25); }
        .form-control::placeholder { color: var(--text-muted); opacity: 0.7; }
        
        .theme-toggle-btn {
            background: var(--bg-subtle);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: 20px;
            padding: 6px 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .theme-toggle-btn:hover {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }
    </style>
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div>
            <div class="d-flex align-items-center justify-content-between px-3 mb-1">
                <button type="button" id="themeToggleBtn" class="theme-toggle-btn" title="Toggle Light/Dark Theme">
                    <i id="themeToggleIcon" class="fa-solid fa-moon"></i>
                    <span class="theme-toggle-label">Dark</span>
                </button>
                <button type="button" id="sidebarToggle" title="Toggle Sidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
            <div class="text-center my-0 sidebar-title d-flex align-items-center justify-content-center">
                <img src="/images/logo.png" alt="EdCo Logo" class="sidebar-logo" />
            </div>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link" href="/Dashboard"><i class="fa-solid fa-chart-line"></i> <span>Dashboard</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/GradeLevels"><i class="fa-solid fa-layer-group"></i> <span>Grade Levels</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/Subjects"><i class="fa-solid fa-book"></i> <span>Subjects</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/Subscriptions"><i class="fa-solid fa-credit-card"></i> <span>Subscriptions</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/Curriculum"><i class="fa-solid fa-sitemap"></i> <span>Content Builder</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/QuizStudio"><i class="fa-solid fa-clipboard-question"></i> <span>Quiz Studio</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/AiPrompts"><i class="fa-solid fa-robot"></i> <span>AI Prompts</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/AiApiKeys"><i class="fa-solid fa-key text-warning"></i> <span>AI API Keys</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/Analytics"><i class="fa-solid fa-magnifying-glass-chart"></i> <span>Analytics</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/AuditLogs"><i class="fa-solid fa-shield-halved"></i> <span>Audit & Governance</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/ErrorLogs"><i class="fa-solid fa-bug text-danger"></i> <span>System Errors</span></a></li>
            </ul>
        </div>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div class="p-3 border-top" style="border-color: var(--border-color) !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="user-profile-text text-truncate me-2">
                        <div class="fw-bold small text-truncate" style="color: var(--text-primary);">@User.Identity.Name</div>
                        <div class="small" style="font-size:0.75rem; color: var(--text-muted);">Administrator</div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Logout">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
    
    <div class="main-content" id="main-content">
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

