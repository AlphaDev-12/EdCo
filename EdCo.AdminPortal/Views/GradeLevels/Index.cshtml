@model List<EdCo.Core.Entities.GradeLevel>
@{
    ViewData["Title"] = "Grade Configuration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-layer-group me-2"></i> Grade Levels</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addGradeModal">
        <i class="fa-solid fa-plus me-1"></i> Add Grade Level
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    @foreach (var grade in Model)
    {
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@grade.Name</span>
                    @if (grade.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong><i class="fa-solid fa-tag text-success me-1"></i> Subscription Fee:</strong> $@grade.TierPrice.ToString("F2")</p>
                    <p class="mb-1"><strong><i class="fa-solid fa-clock text-warning me-1"></i> Duration:</strong> @grade.SubscriptionDurationDays Days (@(Math.Round((double)grade.SubscriptionDurationDays / 30.0, 1)) months)</p>
                    <p class="mb-3"><strong><i class="fa-solid fa-book text-info me-1"></i> Subjects:</strong> @grade.Subjects.Count</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#editGradeModal-@grade.Id">
                            <i class="fa-solid fa-pen"></i> Edit
                        </button>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this grade level and ALL its subjects/chapters/units?');">
                            <input type="hidden" name="id" value="@grade.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i> Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Modal -->
        <div class="modal fade" id="editGradeModal-@grade.Id" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content" style="background-color: var(--bg-surface); border: 1px solid var(--border-color); color: var(--text-primary);">
                    <form asp-action="Edit" method="post">
                        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                            <h5 class="modal-title">Edit Grade Level & Subscription</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="id" value="@grade.Id" />
                            <div class="mb-3">
                                <label class="form-label">Grade Name</label>
                                <input type="text" class="form-control" name="name" value="@grade.Name" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><i class="fa-solid fa-dollar-sign text-success me-1"></i> Subscription Fee ($)</label>
                                <input type="number" step="0.01" min="0" class="form-control" name="tierPrice" value="@grade.TierPrice" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><i class="fa-solid fa-calendar-days text-info me-1"></i> Subscription Duration (Days)</label>
                                <input type="number" min="1" max="3650" class="form-control" name="subscriptionDurationDays" value="@grade.SubscriptionDurationDays" required />
                                <small class="text-muted">Standard: 30 days (1 mo), 90 days (3 mo), 365 days (1 yr)</small>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" @(grade.IsActive ? "checked" : "") />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="fa-solid fa-layer-group fa-4x mb-3"></i>
        <h5>No grade levels configured yet</h5>
        <p>Click "Add Grade Level" to get started.</p>
    </div>
}

<!-- Add Modal -->
<div class="modal fade" id="addGradeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: var(--bg-surface); border: 1px solid var(--border-color); color: var(--text-primary);">
            <form asp-action="Create" method="post">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                    <h5 class="modal-title"><i class="fa-solid fa-plus me-2"></i> Add Grade Level</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Grade Name</label>
                        <input type="text" class="form-control" name="name" placeholder="e.g. Grade 7, Form 4, Form 6" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fa-solid fa-dollar-sign text-success me-1"></i> Subscription Fee ($)</label>
                        <input type="number" step="0.01" min="0" class="form-control" name="tierPrice" value="19.99" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fa-solid fa-calendar-days text-info me-1"></i> Subscription Duration (Days)</label>
                        <input type="number" min="1" max="3650" class="form-control" name="subscriptionDurationDays" value="90" required />
                        <small class="text-muted">Standard: 30 days (1 mo), 90 days (3 mo), 365 days (1 yr)</small>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
