@{
    ViewData["Title"] = "Terms of Service";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5" style="background: #ffffff;">
                <div class="card-header border-0 text-white p-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-primary bg-opacity-25 rounded-3 text-primary">
                            <i class="bi bi-file-earmark-text fs-2"></i>
                        </div>
                        <div>
                            <h1 class="h3 fw-bold mb-1 text-white">EdCo Platform Terms of Service</h1>
                            <p class="text-secondary small mb-0" style="color: #94a3b8 !important;">Effective Date: July 24, 2026</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    
                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-check-circle text-primary me-2"></i>1. Acceptance of Terms</h4>
                        <p class="text-secondary">
                            By accessing or using the <strong>EdCo Platform</strong> (including EdCo API, Admin Portal, and StudyPro Mobile Application), you agree to be bound by these Terms of Service. If you do not agree to these terms, you may not access or use the platform.
                        </p>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge text-primary me-2"></i>2. User Accounts & Responsibilities</h4>
                        <p class="text-secondary">Users are responsible for maintaining the confidentiality of their account credentials. You agree to immediately notify EdCo administration of any unauthorized use of your account or security breaches.</p>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-cpu text-primary me-2"></i>3. AI Evaluation & Academic Honesty</h4>
                        <p class="text-secondary">
                            EdCo utilizes automated AI models for rubric generation, answer scoring, and feedback creation. While AI evaluations undergo continuous refinement and quality guardrails, final grades remain subject to review by authorized educators. Users agree not to submit fraudulent, malicious, or non-academic content to the platform.
                        </p>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-shield-x text-primary me-2"></i>4. Acceptable Use & Rate Limits</h4>
                        <p class="text-secondary">
                            To ensure platform performance and equitable resource usage, EdCo enforces rate limits on authentication, file upload, and AI endpoints. Attempting to bypass security limits, reverse-engineer API routines, or flood servers with automated traffic is strictly prohibited and subject to account suspension.
                        </p>
                    </section>

                    <section class="mb-0">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-envelope-paper text-primary me-2"></i>5. Support & Inquiries</h4>
                        <p class="text-secondary mb-0">
                            For support or legal inquiries regarding these terms, please contact us at:  
                            <a href="mailto:support@edco.com" class="fw-semibold text-decoration-none">support@edco.com</a>.
                        </p>
                    </section>

                </div>
            </div>
        </div>
    </div>
</div>
