@{
    ViewData["Title"] = "Privacy Policy & Data Security";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5" style="background: #ffffff;">
                <div class="card-header border-0 text-white p-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-primary bg-opacity-25 rounded-3 text-primary">
                            <i class="bi bi-shield-check fs-2"></i>
                        </div>
                        <div>
                            <h1 class="h3 fw-bold mb-1 text-white">EdCo Platform Privacy Policy</h1>
                            <p class="text-secondary small mb-0" style="color: #94a3b8 !important;">Effective Date: July 24, 2026 | Compliant with Google Play & App Store Standards</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    
                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-primary me-2"></i>1. Overview</h4>
                        <p class="text-secondary">
                            Welcome to <strong>EdCo</strong> (including the EdCo API, Admin Portal, and StudyPro mobile application). 
                            We are committed to protecting student and educator privacy while providing high-quality AI-assisted learning, assessment, and grading experiences. 
                            This Privacy Policy explains how we collect, use, store, and safeguard personal information.
                        </p>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-database-check text-primary me-2"></i>2. Information We Collect</h4>
                        <p class="text-secondary">We collect the following categories of information to provide core educational services:</p>
                        <ul class="text-secondary">
                            <li><strong>Account Credentials:</strong> Full name, email address, user role (Student, Teacher, Admin), and hashed authentication tokens.</li>
                            <li><strong>Academic Data:</strong> Quiz submissions, student answer sheets, diagram uploads, flashcard progress, and qualitative/quantitative score records.</li>
                            <li><strong>Media & Camera Captures:</strong> Images captured or uploaded by users specifically for OCR processing, handwritten assignment evaluation, or quiz question creation.</li>
                            <li><strong>Technical Telemetry:</strong> Device platform (Android/iOS), app version, request timestamps, and anonymized performance logs.</li>
                        </ul>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-cpu text-primary me-2"></i>3. Use of Artificial Intelligence (AI)</h4>
                        <p class="text-secondary">
                            EdCo utilizes Groq Vision AI and Google Gemini Models to perform automated rubric generation and qualitative/quantitative answer evaluation. 
                            Submissions processed through our AI pipeline are evaluated strictly in memory for grading, credit enforcement, and telemetry accounting. 
                            <strong>We do not sell user submissions or use student academic data to train public third-party AI models.</strong>
                        </p>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-lock text-primary me-2"></i>4. Data Security & Storage</h4>
                        <p class="text-secondary">
                            All network communications are encrypted in transit via SSL/TLS (HTTPS). Uploaded assignments and diagram images are stored securely with strict extension and magic-byte signature validation. 
                            Database records are protected with row-level soft delete rules, strict role-based access control (RBAC), and automated encrypted backups.
                        </p>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-person-x text-primary me-2"></i>5. User Rights & Data Deletion</h4>
                        <p class="text-secondary">
                            Students and educators have the right to review their stored academic logs, request account deletion, or export their assignment histories. 
                            To submit a data access or deletion request, please contact our privacy compliance team.
                        </p>
                    </section>

                    <section class="mb-0">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-envelope-paper text-primary me-2"></i>6. Contact Us</h4>
                        <p class="text-secondary mb-0">
                            If you have questions regarding this Privacy Policy or EdCo's data security practices, please contact us at:  
                            <a href="mailto:privacy@edco.com" class="fw-semibold text-decoration-none">privacy@edco.com</a> or visit our online help center.
                        </p>
                    </section>

                </div>
            </div>
        </div>
    </div>
</div>
