# EdCo Platform Environment Variables Template
# Copy to .env or configure in system / Azure / IIS / Docker

# Database Configuration
ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=EdCoDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True

# JWT Authentication (EdCo.API)
Jwt__Key=YourSuperSecretKeyForJwtAuthenticationWhichMustBeAtLeast32BytesLong!
Jwt__Issuer=EdCoApi
Jwt__Audience=EdCoMobileApp

# Bunny.net Media Storage
BunnyNet__ApiKey=YOUR_BUNNY_API_KEY
BunnyNet__LibraryId=YOUR_LIBRARY_ID
BunnyNet__SecurityKey=YOUR_BUNNY_SECURITY_KEY

# Groq AI Service
Groq__ApiKey=YOUR_GROQ_API_KEY
Groq__BaseUrl=https://api.groq.com/openai/v1
Groq__ModelName=openai/gpt-oss-20b
Groq__VisionModelName=qwen/qwen3.6-27b

# Gemini AI Service
Gemini__ApiKey=YOUR_GEMINI_API_KEY
Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta/models/
Gemini__ModelName=gemini-flash-latest

# Paynow Integration (EdCo.API)
Paynow__IntegrationId=YOUR_INTEGRATION_ID
Paynow__IntegrationKey=YOUR_INTEGRATION_KEY
Paynow__ReturnUrl=http://yourdomain.com/api/v1/subscription/paynow-return
Paynow__ResultUrl=http://yourdomain.com/api/v1/subscription/paynow-result

# Reverse Proxy & Let's Encrypt SSL/TLS Configuration
DOMAIN_API=https://api.edco-platform.com
DOMAIN_ADMIN=https://admin.edco-platform.com
ACME_EMAIL=admin@edco-platform.com

