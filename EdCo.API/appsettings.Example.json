{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/edco-api-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "OpenTelemetry": {
    "ServiceName": "EdCo.API",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://edco.com",
      "https://admin.edco.com",
      "http://localhost:3000",
      "http://localhost:5000",
      "http://localhost:5075"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_SERVER;Database=EdCoDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SUPER_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG!",
    "Issuer": "EdCoApi",
    "Audience": "EdCoMobileApp"
  },
  "BunnyNet": {
    "ApiKey": "YOUR_BUNNY_API_KEY",
    "VideoLibraryId": "YOUR_LIBRARY_ID",
    "SecurityKey": "YOUR_BUNNY_SECURITY_KEY"
  },
  "Groq": {
    "ApiKey": "YOUR_GROQ_API_KEY",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "ModelName": "openai/gpt-oss-20b",
    "VisionModelName": "qwen/qwen3.6-27b"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models/",
    "ModelName": "gemini-flash-latest"
  },
  "Paynow": {
    "IntegrationId": "YOUR_PAYNOW_INTEGRATION_ID",
    "IntegrationKey": "YOUR_PAYNOW_INTEGRATION_KEY",
    "ReturnUrl": "http://localhost:5075/api/v1/subscription/paynow-return",
    "ResultUrl": "http://localhost:5075/api/v1/subscription/paynow-result"
  },
  "MetaWhatsApp": {
    "AccessToken": "YOUR_META_WHATSAPP_ACCESS_TOKEN",
    "PhoneNumberId": "YOUR_PHONE_NUMBER_ID",
    "BusinessAccountId": "YOUR_BUSINESS_ACCOUNT_ID",
    "AppSecret": "YOUR_APP_SECRET",
    "VerifyToken": "YOUR_VERIFY_TOKEN",
    "ApiVersion": "v23.0"
  },
  "Ecocash": {
    "MerchantId": "YOUR_ECOCASH_MERCHANT_ID",
    "MerchantApiKey": "YOUR_ECOCASH_API_KEY",
    "MerchantPin": "YOUR_ECOCASH_PIN",
    "BaseUrl": "https://api.ecocash.co.zw",
    "CallbackUrl": "https://your-domain.com/api/v1/whatsapp/webhook/ecocash-callback"
  },
  "Storage": {
    "LocalUploadPath": "App_Data/Uploads"
  }
}
